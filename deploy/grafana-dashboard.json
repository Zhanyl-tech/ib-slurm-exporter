{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping ib-slurm-exporter",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__comment": "ib-slurm-exporter — per-job InfiniBand/RoCE fabric health. Metric and label names match internal/collector/collector.go exactly. Counter names match internal/ib/ib.go. Import via Dashboards > New > Import.",
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["infiniband", "slurm", "hpc", "fabric"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "InfiniBand / Slurm — per-job fabric health",
  "templating": {
    "list": [
      {
        "name": "job_id",
        "label": "Job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(ib_slurm_job_counter_total, job_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "device",
        "label": "HCA",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(ib_slurm_device_port_up, device)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Attribution health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Unattributed jobs",
      "description": "Jobs whose fabric activity could not be pinned to them because they share a device with another job. The exporter refuses to attribute a shared device rather than mislabel it — this is the count it declined.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 }
          ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(ib_slurm_unattributed_jobs)", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Unresolved SLUID allocations",
      "description": "Cgroups keyed by SLUID (Slurm 26.05+) with no resolver mapping them to a job id. Non-zero means job attribution is degraded on this node — wire up a resolver.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 }
          ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(ib_slurm_unresolved_sluid_allocations)", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Scrape errors",
      "description": "1 when the last scrape failed. A gap in this metric is itself a signal — the exporter is designed so a scrape failure never looks like healthy zeros.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(ib_slurm_scrape_error)", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Shared devices (attribution suppressed)",
      "description": "Devices held by more than one job. On these, per-job counters are intentionally not emitted.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 }
          ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "count(ib_slurm_device_jobs > 1)", "refId": "A" }
      ]
    },
    {
      "type": "row",
      "title": "Per-job fabric errors — the leading indicator of a slow collective",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "type": "timeseries",
      "title": "Retransmit & sequence errors by job",
      "description": "packet_seq_err, out_of_sequence and rnr_nak_retry_err rising on a job's HCA is the fabric telling you a collective is stalling before any throughput chart shows it. These are the counters worth paging on.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        {
          "expr": "sum by (job_id, device, counter) (rate(ib_slurm_job_counter_total{job_id=~\"$job_id\", device=~\"$device\", counter=~\"packet_seq_err|out_of_sequence|rnr_nak_retry_err|local_ack_timeout_err\"}[$__rate_interval]))",
          "legendFormat": "{{job_id}} {{device}} {{counter}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Receive-side errors by job",
      "description": "port_rcv_errors, symbol_error and remote physical errors point at a bad cable, transceiver, or switch port on the path this job is using.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        {
          "expr": "sum by (job_id, device, counter) (rate(ib_slurm_job_counter_total{job_id=~\"$job_id\", device=~\"$device\", counter=~\"port_rcv_errors|symbol_error|port_rcv_remote_physical_errors|port_rcv_switch_relay_errors|link_downed\"}[$__rate_interval]))",
          "legendFormat": "{{job_id}} {{device}} {{counter}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Per-job throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Transmit / receive bandwidth by job",
      "description": "port_xmit_data / port_rcv_data are counted in 4-octet words per the IB spec, so the rate is multiplied by 4 to give bytes/sec.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        {
          "expr": "sum by (job_id, device) (rate(ib_slurm_job_counter_total{job_id=~\"$job_id\", device=~\"$device\", counter=\"port_xmit_data\"}[$__rate_interval])) * 4",
          "legendFormat": "{{job_id}} {{device}} tx",
          "refId": "A"
        },
        {
          "expr": "sum by (job_id, device) (rate(ib_slurm_job_counter_total{job_id=~\"$job_id\", device=~\"$device\", counter=\"port_rcv_data\"}[$__rate_interval])) * 4",
          "legendFormat": "{{job_id}} {{device}} rx",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Transmit discards by job",
      "description": "port_xmit_discards is congestion — packets dropped because the send queue could not drain. Correlates with the retransmit panel above.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        {
          "expr": "sum by (job_id, device) (rate(ib_slurm_job_counter_total{job_id=~\"$job_id\", device=~\"$device\", counter=\"port_xmit_discards\"}[$__rate_interval]))",
          "legendFormat": "{{job_id}} {{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Device level (always present, unattributed)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "type": "state-timeline",
      "title": "Port state",
      "description": "ib_slurm_device_port_up — 1 when the port is ACTIVE. Device-level metrics are emitted whether or not a job could be attributed, so a fabric problem is visible even on a shared or unattributed device.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 80 },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "ACTIVE", "color": "green" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "ib_slurm_device_port_up{device=~\"$device\"}",
          "legendFormat": "{{device}}:{{port}} ({{link_layer}} {{rate}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Detected cgroup layout",
      "description": "ib_slurm_cgroup_layout_info — which cgroup layout the exporter detected on this node (v1, v2, or v2+SLUID). SLUID layout is where the unresolved-allocation metric matters.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "options": { "showHeader": true },
      "targets": [
        { "expr": "ib_slurm_cgroup_layout_info", "format": "table", "instant": true, "refId": "A" }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true } } }
      ]
    }
  ]
}
